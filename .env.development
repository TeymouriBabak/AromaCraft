NODE_ENV=development
PORT=3000

# Canonical database for local development (host access)
DATABASE_URL="mysql://root:devpass@127.0.0.1:3308/aromacraft"

# Redis (host published port)
REDIS_URL=redis://127.0.0.1:6379

# Mailpit SMTP testing (host-side)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=mailpit_user
SMTP_PASSWORD=mailpit_password
SMTP_FROM=noreply@aromacraft.test

# Provider selection (keep docker internal values for container runtime)
EMAIL_PROVIDER=local_mailpit
SMS_PROVIDER=mock_sms
STORAGE_PROVIDER=local_files
USE_MOCKS=true
DOCKER_ENVIRONMENT=true

# Application secrets (placeholder values for development)
SESSION_COOKIE_NAME=aromacraft_sid
AUTH_SECRET=dev_auth_secret_please_change
JWT_SECRET=dev_jwt_secret_please_change
SESSION_SECRET=dev_session_secret_please_change

# Dev-friendly rate limits
RATE_LIMIT_LOGIN=20:900
RATE_LIMIT_SIGNUP=10:3600
RATE_LIMIT_OTP_VERIFY=20:900
RATE_LIMIT_OTP_RESEND=10:3600
RATE_LIMIT_PASSWORD_RESET=5:3600

# Seed manager account (used by prisma/seed.ts)
SEED_MANAGER_EMAIL=manager@aromacraft.test
SEED_MANAGER_USERNAME=Manager_Aroma
SEED_MANAGER_PASSWORD=ManagerPass123!

# Development mock password for in-memory fixture users
DEV_MOCK_PASSWORD=devpass

# Docker/dev helper vars
DB_PORT=3308
SMS_MOCK_ENDPOINT=http://localhost:3010/sms
SMOKE_BASE_URL=http://127.0.0.1:3000
ENABLE_DEV_OTP_ENDPOINT=true
