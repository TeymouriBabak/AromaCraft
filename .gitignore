# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local Docker database data
/mariadb-local/

# Local editor settings
/.vscode/

# Local backups
/backups/

# Temporary auth/debug artifacts
/cookies.txt
/headers.txt
/login_body.txt
/logout_body.txt
/me_body.txt

# Generated reports
/lint-report.json
/type-report.txt

# Temporary QA output
/qc

# Ignore vitest runner output and rebase editor artifacts
vitest_output.log
.git-rebase-editor.sh
