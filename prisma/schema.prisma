generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique @db.VarChar(120)
  name               String?
  firstName          String?             @db.VarChar(120)
  lastName           String?             @db.VarChar(120)
  gender             String?             @db.VarChar(80)
  mobile             String?             @unique @db.VarChar(40)
  countryCode        String?             @db.VarChar(10)
  email              String              @unique
  passwordHash       String              @db.VarChar(255)
  avatarUrl          String?             @db.VarChar(255)
  emailVerified      DateTime?
  role               UserRole            @default(CUSTOMER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bannedAt           DateTime?
  bannedBy           String?
  isBanned           Boolean             @default(false)
  orders             Order[]
  reviews            Review[]
  refundRequests     RefundRequest[]
  sessions           Session[]
  activities         UserActivity[]
  verificationTokens VerificationToken[]
  wishlistItems      WishlistItem[]

  @@index([email])
  @@index([username])
}

model Session {
  id              String        @id @default(cuid())
  tokenHash       String        @unique @db.VarChar(255)
  userId          String
  status          SessionStatus @default(ACTIVE)
  isAuthenticated Boolean       @default(false)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id               Int         @id
  slug             String      @unique
  catalog          String      @default("shop") // "shop" | "home"
  name             String
  brand            String
  price            Decimal     @db.Decimal(12, 2)
  rating           Float
  reviews          Int
  image            String
  roast            String
  process          String
  origin           String
  originRegion     String
  country          String
  coffeeType       String
  body             String
  acidity          String
  sweetness        String
  size             String
  description      String
  inStock          Boolean     @default(true)
  inventory        Int         @default(100)
  lowStockThreshold Int         @default(5)
  status           String      @default("active")
  brewMethods      Json
  grindTypes       Json
  tastingNotes     Json
  specialTags      Json
  originalPrice    Float?
  badge            String?
  imageAlt         String?
  subscriptionEligible Boolean @default(false)
  subscriptionSavings  Float?
  altitude             String?
  variety              String?
  notes                String?
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopFilter {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  type      String   @default("select")
  options   Json?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  content   String   @db.Text
  image     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model PromotionalBanner {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
}

model OurStory {
  id        String   @id @default("default")
  title     String
  body      String   @db.Text
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model Order {
  id             String          @id @default(cuid())
  userId         String?
  status         OrderStatus     @default(PENDING)
  subtotal       Decimal         @db.Decimal(12, 0)
  shippingFee    Decimal         @db.Decimal(12, 0)
  total          Decimal         @db.Decimal(12, 0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User?           @relation(fields: [userId], references: [id])
  items          OrderItem[]
  refundRequests RefundRequest[]

  @@index([userId])
  @@index([status])
}

model RefundRequest {
  id          String              @id @default(cuid())
  orderId     String
  userId      String?
  requestedAt DateTime            @default(now())
  amount      Decimal             @db.Decimal(12, 0)
  reason      String              @db.Text
  status      RefundRequestStatus @default(REQUESTED)
  decisionAt  DateTime?
  decidedBy   String?
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([requestedAt])
}

model UserActivity {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String?
  action     String   @db.VarChar(160)
  metadata   Json?
  durationMs Int?     @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Review {
  id        String     @id @default(cuid())
  userId    String
  productId String?
  rating    Int        @default(5)
  title     String     @db.VarChar(160)
  content   String     @db.Text
  type      ReviewType @default(HOME)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime   @default(now())
  moderatedAt DateTime?
  moderatedBy String?
  rejectionReason String? @db.Text
  hiddenAt  DateTime?
  hiddenBy  String?
  isHidden  Boolean    @default(false)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

model VerificationToken {
  id           String                @id @default(cuid())
  userId       String
  type         VerificationTokenType @default(EMAIL_VERIFICATION)
  token        String                @unique @db.VarChar(255)
  otpHash      String?               @db.VarChar(255)
  verified     Boolean               @default(false)
  usedCount    Int                   @default(0)
  attemptCount Int                   @default(0)
  createdAt    DateTime              @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId Int
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 0)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model BannedIdentity {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(32)
  value     String   @db.VarChar(255)
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@index([type])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReviewType {
  HOME
  PRODUCT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  LOGIN_OTP
  PURCHASE_OTP
}
