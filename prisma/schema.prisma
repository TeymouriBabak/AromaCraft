generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique @db.VarChar(120)
  name         String?
  firstName    String?   @db.VarChar(120)
  lastName     String?   @db.VarChar(120)
  gender       String?   @db.VarChar(80)
  mobile       String?   @db.VarChar(40)
  countryCode  String?   @db.VarChar(10)
  email        String    @unique
  passwordHash String    @db.VarChar(255)
  avatarUrl    String?   @db.VarChar(255)
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  orders       Order[]

  @@index([email])
  @@index([username])
}

model Session {
  id        String        @id @default(cuid())
  tokenHash String        @unique @db.VarChar(255)
  userId    String
  status    SessionStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(120)
  name        String    @db.VarChar(160)
  description String?   @db.Text
  price       Decimal   @db.Decimal(12, 0)
  inventory   Int       @default(0)
  imageUrl    String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]

  @@index([slug])
}

model Order {
  id          String      @id @default(cuid())
  userId      String?
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(12, 0)
  shippingFee Decimal     @db.Decimal(12, 0)
  total       Decimal     @db.Decimal(12, 0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 0)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}
