## Copy this file to .env and fill in your local secrets.
## Never commit .env or any real credentials.

NODE_ENV=development
PORT=3000

# Database connection used by Prisma and the app container.
# For local dev you can use localhost:3306 or a docker host.
DATABASE_URL="mysql://replace_with_app_user:replace_with_password@localhost:3306/aromacraft"

# MariaDB / MySQL container variables (placeholders)
MYSQL_ROOT_PASSWORD=replace_with_root_password
MYSQL_DATABASE=aromacraft
MYSQL_USER=replace_with_app_user
MYSQL_PASSWORD=replace_with_password

# Redis
REDIS_URL=redis://localhost:6399

# Mailpit SMTP testing
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dev@aromacraft.local
MAILPIT_UI=http://localhost:8025

# Provider selection
EMAIL_PROVIDER=local_mailpit
SMS_PROVIDER=mock_sms
# Messaging provider for development: 'console' prints OTPs to server console
MESSAGING_PROVIDER=console
# Production/real provider placeholders (configure in production only)
SMS_API_KEY=
SMS_SENDER=
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
STORAGE_PROVIDER=local_files
USE_MOCKS=true

# Security and app secrets (use real long values locally, not in repo)
SESSION_COOKIE_NAME=aromacraft_sid
AUTH_SECRET=replace_with_long_random_secret
JWT_SECRET=replace_with_long_random_secret
SESSION_SECRET=replace_with_long_random_secret

# Optional application flags
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RATE_LIMIT_LOGIN=5:900
RATE_LIMIT_SIGNUP=3:3600
RATE_LIMIT_OTP_VERIFY=5:900
RATE_LIMIT_OTP_RESEND=3:3600
RATE_LIMIT_PASSWORD_RESET=3:3600

# Docker/dev helper vars
DB_PORT=3307
DOCKER_ENVIRONMENT=false
SMS_MOCK_URL=http://localhost:3001
SMOKE_BASE_URL=http://127.0.0.1:3000
ENABLE_DEV_OTP_ENDPOINT=false

