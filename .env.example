# SMS configuration
# Options: mock | twilio | sns
SMS_PROVIDER=mock
SMS_MOCK_ENDPOINT=http://localhost:3000/sms

# Twilio (if using provider=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS SNS (if using provider=sns)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Avatar storage: 'local' or 's3'
AVATAR_STORAGE=local
AVATAR_S3_BUCKET=
AVATAR_S3_REGION=
# Local database configuration for AromaCraft
DATABASE_URL="mysql://aromacraft_user:local_app_password@127.0.0.1:3307/aromacraft"
DB_PORT="3307"
AUTH_SECRET="development-auth-secret-change-me"
MYSQL_DATABASE="aromacraft"
MYSQL_USER="aromacraft_user"
MYSQL_PASSWORD="local_app_password"
MYSQL_ROOT_PASSWORD="change_this_root_password"

# SMTP (MailHog)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aromacraft.test

# SMS (mock)
SMS_PROVIDER=mock
SMS_MOCK_ENDPOINT=http://127.0.0.1:3010/sms

# Other
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
