# Local database configuration for AromaCraft
DATABASE_URL="mysql://aromacraft_user:local_app_password@127.0.0.1:3307/aromacraft"
DB_PORT="3307"
AUTH_SECRET="development-auth-secret-change-me"
MYSQL_DATABASE="aromacraft"
MYSQL_USER="aromacraft_user"
MYSQL_PASSWORD="local_app_password"
MYSQL_ROOT_PASSWORD="change_this_root_password"

# SMTP (MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aromacraft.test

# SMS (mock)
SMS_PROVIDER=mock
SMS_MOCK_ENDPOINT=http://mock-sms:3000/sms

# Other
NEXT_PUBLIC_API_BASE_URL=
