{
  "name": "aromacraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:docker": "docker compose up -d",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "deps:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "deps:down": "docker compose -f docker-compose.dev.yml down",
    "test:integration": "npm run deps:up && npx vitest run && npm run deps:down",
    "db:check": "npx -y tsx scripts/verify-db-connection.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx -y tsx prisma/seed.ts",
    "db:init": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:backup": "bash scripts/backup-mariadb.sh",
    "db:restore": "bash scripts/restore-mariadb.sh",
    "prisma": "prisma"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.1.4",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.7",
    "libphonenumber-js": "^1.13.9",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.26.0",
    "mysql2": "^3.23.2",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.9.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-phone-number-input": "^3.4.17",
    "recharts": "^2.6.2",
    "redis": "^4.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
